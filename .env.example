# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata/links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk -> Webhooks -> endpoint signing secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (Project Settings -> API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used by the Clerk webhook to sync users/orgs/memberships
SUPABASE_SECRET_KEY=

# Local Supabase CLI only: your Clerk Frontend API domain (no https://)
CLERK_DOMAIN=
